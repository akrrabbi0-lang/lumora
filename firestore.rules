rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // One document per user per UTC day. The id is checked against the server date,
    // so a second download on the same day is rejected.
    match /downloads/{id} {
      allow get: if request.auth != null && id.matches(request.auth.uid + '_[0-9]+');
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'clipId', 'at'])
        && id == request.auth.uid + '_' + string(request.time.year() * 10000 + request.time.month() * 100 + request.time.day());
    }
  }
}
