rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'akr.rabbi0@gmail.com'
        && request.auth.token.email_verified == true;
    }

    // One document per user per UTC day. The id is checked against the server date,
    // so a second download on the same day is rejected.
    match /downloads/{id} {
      allow get: if request.auth != null && id.matches(request.auth.uid + '_[0-9]+');
      allow list: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'clipId', 'at'])
        && id == request.auth.uid + '_' + string(request.time.year() * 10000 + request.time.month() * 100 + request.time.day());
    }

    // Ads uploaded from admin.html. Everyone can read. Only the owner can create, edit or delete.
    // Visitors can only add exactly +1 to "views", and never above "maxViews".
    match /ads/{adId} {
      allow read: if true;
      allow create, delete: if isOwner();
      allow update: if isOwner()
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['views'])
            && request.resource.data.views == resource.data.views + 1
            && request.resource.data.views <= resource.data.maxViews);
    }
  }
}
