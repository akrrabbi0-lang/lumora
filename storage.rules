rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner() {
      return request.auth != null
        && request.auth.token.email == 'akr.rabbi0@gmail.com'
        && request.auth.token.email_verified == true;
    }
    function okFile() {
      return (request.resource.contentType.matches('video/.*') || request.resource.contentType.matches('image/.*'))
        && request.resource.size < 200 * 1024 * 1024;
    }

    match /clips/{file} {
      allow read: if true;
      allow create, update: if isOwner() && okFile();
      allow delete: if isOwner();
    }
    match /ads/{file} {
      allow read: if true;
      allow create, update: if isOwner() && okFile();
      allow delete: if isOwner();
    }
  }
}
